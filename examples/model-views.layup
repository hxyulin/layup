// Define the architecture once, then choose a view with --view overview/detail.
// Explicit IDs keep references and presentation steps stable between views.
model "Job processing" layout=auto {
  style service node blue
  service client "Client"
  service api "Job API"
  group processing "Processing" {
    node queue "Queue" purple
    node worker "Worker" green {
      code "process(job)"
      sub "Retries failed jobs"
    }
    node store "Object storage" orange
  }
  client -> api "submit"
  api -> queue "enqueue"
  queue -> worker "consume"
  worker -> store "save"

  view overview "Job processing · overview" direction=right {
    include client api processing
  }
  // Ancestor containers remain around selected descendants. Unselected
  // siblings and connections to them disappear; endpoint IDs never change.
  view detail "Job processing · worker" direction=down {
    include queue worker store
  }
}
