// The scene keeps its measured layout, then fits into a 16:9 presentation.
diagram "A request through the system" layout=auto direction=right slide=wide slide-padding=48 min-font-size=18 {
  note "Uniform scaling preserves node shapes, routing, and international text."
  process client "Client" blue
  process api "API" green
  process store "Storage" purple

  client -> api "Request"
  api -> store "Query"
}
