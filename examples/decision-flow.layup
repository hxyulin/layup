diagram main "Validate a request" type=graph layout=auto flow-direction=right width=1200 {
  node request "Receive request" style=process palette=blue {
    code "POST /orders"
  }
  node valid "Is the request valid?" style=decision palette=yellow
  node accepted "Accept order" style=terminal palette=green
  node rejected "Reject request" style=terminal palette=red
  ::request -> ::valid
  ::valid -> ::accepted "Yes"
  ::valid -> ::rejected "No"
}
