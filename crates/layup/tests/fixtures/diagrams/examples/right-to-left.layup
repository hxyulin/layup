diagram main "معالجة الطلبات" type=graph width=1100 layout=auto flow-direction=left text-direction=rtl subtitle="يسير الرسم من اليمين إلى اليسار، ويظل الرمز البرمجي معزولاً." {
  node request "طلب جديد" {
    text "يستقبل النظام الطلب ويبدأ المعالجة."
  }
  node worker "المعالجة" {
    text "يستخدم العامل `GET /items` لقراءة البيانات."
  }
  node result "النتيجة" {
    text "يعيد النظام النتيجة إلى المستخدم."
  }
  ::request -> ::worker
  ::worker -> ::result
}
