diagram main "Submit and process a request" type=sequence subtitle="Validate the payload before starting work." {
  actor user "User" palette=blue
  participant browser "Browser" palette=green
  participant api "API" palette=purple
  participant worker "Worker" palette=orange
  message submit ::user -> ::browser "Submit request"
  message request ::browser -> ::api "POST /jobs"
  note "Validate the payload before starting work." over=::api
  message validate ::api -> ::api "Validate and authorize"
  message enqueue ::api -> ::worker "Queue job" delivery=async
  message accepted ::api -> ::browser "202 Accepted" type=reply
  loop "Until the job completes" {
    message poll ::browser -> ::api "GET /jobs/:id"
    alternatives "Job status" {
      branch "Complete" {
        message result ::api -> ::browser "200 + result" type=reply
      }
      branch "Still running" {
        message pending ::api -> ::browser "200 + pending" type=reply
      }
    }
  }
  optional "Notify the user" {
    message display ::browser -> ::user "Display the result"
  }
}
