// Fictional background job pipeline: automatic tones and vertical routing.
diagram main "Background job pipeline" type=graph subtitle="Durable work moves through three stages." {
  node gateway "Accept work" {
    code "POST /jobs"
    text "Validate input and return a job ID."
  }
  node queue "Queue" {
    code "enqueue(job)"
    text "Keep pending jobs until a worker acknowledges them."
  }
  node worker "Worker" {
    code "process(job)"
    text "Retry transient failures and record the result."
  }
  ::gateway -> ::queue "enqueue"
  ::queue -> ::worker "dispatch"
}
