diagram main "A growing service" type=graph layout=auto {
  node input "Input" {
    code "accept(request)"
  }
  node notes "Notes" {
    text "An unrelated operational note."
  }
  node worker "Worker" {
    code "process(request)"
  }
  node store "Store" {
    code "persist(result)"
  }
  ::input -> ::worker
  ::worker -> ::store
}
