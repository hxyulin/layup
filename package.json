{
  "name": "layup-workspace",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "wasm": "node tools/build-wasm.mjs",
    "docs:dev": "pnpm wasm && pnpm --filter @layup/docs dev",
    "docs:build": "pnpm wasm && pnpm --filter @layup/docs build",
    "docs:preview": "pnpm --filter @layup/docs preview",
    "docs:test": "pnpm docs:build && pnpm --filter @layup/docs test",
    "test:js": "pnpm wasm && pnpm --filter @hxyulin/layup test",
    "showcase": "node tools/render-showcase.mjs",
    "showcase:check": "node tools/render-showcase.mjs --check",
    "repo:check": "node tools/check-repository.mjs"
  },
  "devDependencies": {
    "markdown-it": "^14.3.2",
    "yaml": "^2.9.1"
  }
}
