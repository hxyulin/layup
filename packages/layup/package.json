{
  "name": "@hxyulin/layup",
  "version": "0.3.0",
  "description": "Authored-layout diagrams rendered to SVG, compiled to WebAssembly",
  "keywords": [
    "diagram",
    "svg",
    "architecture",
    "markdown-it",
    "vitepress",
    "wasm"
  ],
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hxyulin/layup.git",
    "directory": "packages/layup"
  },
  "homepage": "https://hxyulin.github.io/layup/reference/api.html",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "node": "./node.js",
      "default": "./browser.js"
    },
    "./markdown-it": {
      "types": "./markdown-it.d.ts",
      "default": "./markdown-it.js"
    },
    "./client": "./client.js"
  },
  "files": [
    "*.js",
    "*.d.ts",
    "layup.wasm",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "OFL.txt"
  ],
  "scripts": {
    "test": "node --test",
    "prepack": "node ../../tools/build-wasm.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "markdown-it": "^14.1.0"
  }
}
