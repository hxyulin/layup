{
  "name": "layup",
  "version": "0.2.0-dev",
  "description": "Authored-layout diagrams rendered to SVG, compiled to WebAssembly",
  "license": "MIT OR Apache-2.0",
  "repository": "github:hxyulin/layup",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "node": "./node.js",
      "default": "./browser.js"
    },
    "./markdown-it": {
      "types": "./markdown-it.d.ts",
      "default": "./markdown-it.js"
    },
    "./client": "./client.js"
  },
  "files": [
    "*.js",
    "*.d.ts",
    "*.css",
    "layup.wasm"
  ],
  "scripts": {
    "test": "node --test"
  },
  "devDependencies": {
    "markdown-it": "^14.1.0"
  }
}
